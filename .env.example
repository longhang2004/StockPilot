NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://stockpilot_app:stockpilot_app@localhost:5432/stockpilot
MIGRATION_DATABASE_URL=postgresql://stockpilot_admin:stockpilot_admin@localhost:5432/stockpilot
# Optional dedicated pg-boss database URL for the hosted API/job runner. When
# blank, the API remains usable locally without a queue worker.
QUEUE_DATABASE_URL=
CSRF_SECRET=change-me-with-at-least-32-characters
SESSION_COOKIE_NAME=stockpilot_session
SESSION_TTL_HOURS=12
DEMO_MODE=true
DEMO_ORGANIZATION_SLUG=stockpilot-demo
QUEUE_REQUIRED=false
WEBHOOK_SIGNING_SECRET=change-me-in-development
# Optional Sentry DSN. Leave blank for local development.
SENTRY_DSN=
