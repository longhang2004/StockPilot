NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Canonical web origin used by metadata, robots, sitemap and JSON-LD.
SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://stockpilot_app:stockpilot_app@localhost:5432/stockpilot
MIGRATION_DATABASE_URL=postgresql://stockpilot_admin:stockpilot_admin@localhost:5432/stockpilot
# Optional dedicated pg-boss database URL for the hosted API/job runner. When
# blank, the API remains usable locally without a queue worker.
QUEUE_DATABASE_URL=
CSRF_SECRET=change-me-with-at-least-32-characters
SESSION_COOKIE_NAME=stockpilot_session
SESSION_TTL_HOURS=12
# Active sessions kept per user; the oldest beyond this cap are revoked when
# a new session is issued (bounds session-table growth and the stolen-session
# surface).
MAX_ACTIVE_SESSIONS_PER_USER=10
# Rate limiting (per API process; see docs/operations.md).
# Public writes per client per route per minute (webhooks etc.).
RATE_LIMIT_PUBLIC_WRITES_PER_MIN=60
# Stricter tier for public credential endpoints (login/signup/demo-login).
RATE_LIMIT_AUTH_WRITES_PER_MIN=10
# Cap on authenticated writes per user per minute.
RATE_LIMIT_USER_WRITES_PER_MIN=240
# Per-account sign-in brute-force throttle: failed attempts for the same
# (email, client) pair within the window; then blocked for the block period.
# Successful sign-in clears the counter.
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_FAILURE_BLOCK_MINUTES=15
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For
# for rate limiting. Empty (safe default): the limiter keys on the socket
# peer address only.
TRUSTED_PROXY_CIDRS=
DEMO_MODE=true
DEMO_ORGANIZATION_SLUG=stockpilot-demo
QUEUE_REQUIRED=false
WEBHOOK_SIGNING_SECRET=change-me-in-development
# Optional product image storage. Prefer CLOUDINARY_URL; explicit values are
# supported for providers that do not expose a connection URL.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional Sentry DSN. Leave blank for local development.
SENTRY_DSN=
# Optional Stripe SaaS billing. Leave blank to run without billing (the demo
# workspace always shows its synthetic Demo Pro plan).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
