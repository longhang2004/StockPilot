{
  "name": "stockpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @stockpilot/contracts build && pnpm --filter @stockpilot/api build && pnpm --filter @stockpilot/web build",
    "dev": "pnpm --parallel --filter @stockpilot/api --filter @stockpilot/web dev",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @stockpilot/contracts build && pnpm -r --if-present typecheck",
    "typecheck:e2e": "tsc -p tests/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @stockpilot/contracts test && pnpm --filter @stockpilot/api test:unit && pnpm --filter @stockpilot/web test:unit",
    "test:e2e": "playwright test",
    "test:e2e:production": "bash scripts/run-production-e2e.sh",
    "test:release-gate": "node --test scripts/check-release-readiness.test.mjs",
    "test:ops-guards": "node --test scripts/check-release-readiness.test.mjs scripts/perf-target.test.mjs",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "perf:local": "bash scripts/run-local-performance.sh",
    "db:generate": "pnpm --filter @stockpilot/api prisma:generate",
    "db:migrate": "pnpm --filter @stockpilot/api prisma:migrate",
    "db:seed": "pnpm --filter @stockpilot/api prisma:seed",
    "compress": "bash compress.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "js-yaml": "5.4.1",
      "nanoid": "3.3.18"
    }
  }
}
