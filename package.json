{
  "name": "stockpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @stockpilot/contracts build && pnpm --filter @stockpilot/api build && pnpm --filter @stockpilot/web build",
    "dev": "pnpm --parallel --filter @stockpilot/api --filter @stockpilot/web dev",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @stockpilot/contracts build && pnpm -r --if-present typecheck",
    "typecheck:e2e": "tsc -p tests/tsconfig.json",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @stockpilot/contracts test && pnpm --filter @stockpilot/api test:unit && pnpm --filter @stockpilot/web test:unit",
    "test:e2e": "playwright test",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "db:generate": "pnpm --filter @stockpilot/api prisma:generate",
    "db:migrate": "pnpm --filter @stockpilot/api prisma:migrate",
    "db:seed": "pnpm --filter @stockpilot/api prisma:seed",
    "compress": "bash compress.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "js-yaml": "5.2.2",
      "nanoid": "3.3.18"
    }
  }
}
